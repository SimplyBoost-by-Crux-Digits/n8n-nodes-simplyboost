{
	"name": "n8n-nodes-simplyboost",
	"version": "0.1.0",
	"description": "n8n nodes for SimplyBoost: ask your AI support agent, keep its knowledge in step with your systems, and act on handovers, leads and synced knowledge.",
	"license": "MIT",
	"homepage": "https://simplyboost.io/docs/api",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"simplyboost",
		"ai",
		"customer-support",
		"knowledge-base",
		"chatbot"
	],
	"author": {
		"name": "Crux Digits B.V. (SimplyBoost)",
		"email": "hello@simplyboost.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/tomdxb0004/n8n-nodes-simplyboost.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SimplyBoostApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SimplyBoost/SimplyBoost.node.js",
			"dist/nodes/SimplyBoostTrigger/SimplyBoostTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.55.5",
		"eslint": "9.39.4",
		"n8n-workflow": "2.16.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
